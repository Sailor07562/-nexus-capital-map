# B-002 authenticated read-only PostgreSQL verification. Keep credentials only in a local ignored .env.
NEXUS_COMMAND_TOWER_HOST=0.0.0.0
NEXUS_COMMAND_TOWER_PORT=8080
# Required for B-002 PostgreSQL verification.
# NEXUS_POSTGRES_HOST=host.docker.internal
# NEXUS_POSTGRES_PORT=5432
# NEXUS_POSTGRES_DATABASE=postgres
# NEXUS_POSTGRES_PASSWORD=<local-password-for-nexus_command_tower_ro>
# NEXUS_PSQL_PATH=psql
# Optional: unauthenticated HTTP HEAD reachability only.
# NEXUS_N8N_URL=http://host.docker.internal:5678/healthz
# NEXUS_CAPITAL_TRACKER_URL=http://host.docker.internal:PORT/health
